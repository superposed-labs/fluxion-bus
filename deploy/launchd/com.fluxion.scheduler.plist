<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Fluxion scheduler — macOS launchd user agent.

  Install (replace __FLUXION_REPO__ with the absolute path to your checkout first):
    sed 's#__FLUXION_REPO__#'"$PWD"'#g' deploy/launchd/com.fluxion.scheduler.plist \
      > ~/Library/LaunchAgents/com.fluxion.scheduler.plist
    launchctl load -w ~/Library/LaunchAgents/com.fluxion.scheduler.plist

  Stop / reload:
    launchctl unload ~/Library/LaunchAgents/com.fluxion.scheduler.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fluxion.scheduler</string>

  <key>ProgramArguments</key>
  <array>
    <string>__FLUXION_REPO__/.venv/bin/fluxion-scheduler</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>FLUXION_ENV_FILE</key>
    <string>__FLUXION_REPO__/.env</string>
    <key>FLUXION_WORKSPACE_ROOT</key>
    <string>__FLUXION_REPO__</string>
    <key>FLUXION_DATA_DIR</key>
    <string>__FLUXION_REPO__/data</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__FLUXION_REPO__</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__FLUXION_REPO__/data/logs/scheduler.out.log</string>
  <key>StandardErrorPath</key>
  <string>__FLUXION_REPO__/data/logs/scheduler.err.log</string>
</dict>
</plist>
