# EditorConfig — consistent editor defaults across the repo.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Python and Swift use 4-space indentation.
[*.py]
indent_size = 4
max_line_length = 100

[*.swift]
indent_size = 4

# Web sources (TS/TSX/JS/JSON/CSS/HTML) use 2-space indentation.
[*.{ts,tsx,js,jsx,json,css,html}]
indent_size = 2

[*.{yml,yaml,toml}]
indent_size = 2

[*.md]
# Markdown can use trailing whitespace for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
