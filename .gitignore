.env
.venv/
__pycache__/
src/fluxion/_version.py
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
.DS_Store
.antigravitycli/

data/
*.log

# Provider gateway routing config, written by `fluxion-provider init`. Local to
# each machine: it names workspace paths, enabled providers, and model ids.
config/provider_routes.json

# Frontend build output is generated by `cd web && npm run build`.
src/fluxion/web/static/

# macOS desktop app build output. The bundle is assembled by desktop/build.sh
# from tracked sources under desktop/ and desktop/Resources/.
desktop/Fluxion*.app/
dist/

# Vendored Sparkle framework, fetched + cached on demand by desktop/build.sh
# (pinned by version + checksum). Not tracked; re-downloaded when missing.
desktop/Frameworks/

scratch/
cache/

# Inbound chat attachments saved into the workspace by channel adapters
.fluxion_inbox/

# Coverage output, generated ad hoc
.coverage

# Xcode per-user state, not project configuration
**/xcuserdata/
