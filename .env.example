# Minimal Fluxion configuration template.
# Recommended: run `fluxion init` to generate this file with real absolute paths.
# If you copy this file manually, replace every /absolute/path/... placeholder.

# Load this file explicitly when Fluxion is started by an MCP client or service
# whose working directory is not the Fluxion checkout.
FLUXION_ENV_FILE=/absolute/path/to/fluxion/.env

# Fluxion checkout and local state.
FLUXION_WORKSPACE_ROOT=/absolute/path/to/fluxion
FLUXION_DATA_DIR=data

# First workspace that Fluxion may read/write when running sub-agents.
FLUXION_ALLOWED_WORKSPACES=/absolute/path/to/project

# Default executor: codex, claude, or antigravity.
FLUXION_DEFAULT_EXECUTOR=codex

# How many sub-agent runs one Fluxion process executes at once (default 3).
# Writes to the same workspace are serialized regardless, so this only lets
# unrelated work overlap. Lower it if concurrent agent CLIs strain this machine
# or your provider quota. See .env.advanced.example for the paired in-flight cap.
FLUXION_WORKER_COUNT=3

# Keep optional services off in the minimal template.
# Enable and configure messaging channels in .env.advanced.example when needed.
FLUXION_SLACK_ENABLED=false
FLUXION_SCHEDULER_ENABLED=false
