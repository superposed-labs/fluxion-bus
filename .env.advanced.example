# Advanced Fluxion configuration reference.
# New users should run `fluxion init` or copy `.env.example` instead. If you
# copy this file manually, replace every /absolute/path/... placeholder before
# starting Fluxion.
FLUXION_ENV=dev
# Optional: force config loading from this file when Fluxion is started by
# an MCP client whose working directory is not the Fluxion checkout.
FLUXION_ENV_FILE=/absolute/path/to/fluxion/.env
FLUXION_WORKSPACE_ROOT=/absolute/path/to/fluxion
FLUXION_ALLOWED_WORKSPACES=/absolute/path/to/fluxion
# Optional MCP/CLI authorization policy:
# - trusted roots allow read-only runs for discovered Git repos
# - write allowlist is required for workspace-write outside registered projects
# - denied workspaces always win
FLUXION_TRUSTED_WORKSPACE_ROOTS=
FLUXION_WORKSPACE_DISCOVERY=false
FLUXION_DENIED_WORKSPACES=
FLUXION_WRITE_ALLOWED_WORKSPACES=
# Optional project registry for MCP/CLI callers. A "project" is a named,
# pre-authorized workspace + default executor: run_subagent can then take
# project="web" instead of an absolute workspace path on every call (and it
# skips the write-allowlist check above). With no projects configured, callers
# must pass an absolute `workspace` path per run. list_projects returns whatever
# is registered here.
# Recommended: point to a JSON file such as ./projects.json.
FLUXION_PROJECTS_FILE=
# Inline alternative — comma-separated entries of the form
#   key=/absolute/workspace|executor=<claude|codex|antigravity>|description=<text>
# FLUXION_PROJECTS=web=/absolute/path/web|executor=antigravity|description=UI tasks,api=/absolute/path/api|executor=codex
FLUXION_PROJECTS=
FLUXION_SLACK_ALLOW_CHANNELS=false
FLUXION_SLACK_REQUIRE_MENTION_IN_CHANNELS=true
# Format: C12345678:/absolute/path/projectA,C23456789:/absolute/path/projectB
FLUXION_SLACK_CHANNEL_WORKSPACES=
# Comma-separated Slack user IDs allowed to drive the bot. REQUIRED: this is
# fail-closed, so an empty list rejects everyone (the bot will not respond).
FLUXION_SLACK_ALLOWED_USERS=U01234567,U08999999
# Relative paths are resolved under FLUXION_WORKSPACE_ROOT.
FLUXION_DATA_DIR=data
FLUXION_DEFAULT_EXECUTOR=codex
FLUXION_TASK_TIMEOUT_SEC=1800
# Max single get_task_status long-poll (ms). A caller's wait_ms is capped to this
# so one blocking poll stays under the MCP client's per-call request timeout;
# fewer round-trips for long runs. Default 60000 (60s). Set it to your MCP
# client's tool-call timeout minus a margin — e.g. Claude Code tolerates well
# over 89s here, so 60000 is safe; lower it for stricter clients.
FLUXION_MCP_STATUS_MAX_WAIT_MS=60000
# Concurrent runs per Fluxion process. Each MCP client session starts its own
# process with its own workers, so this governs how many sub-agent tasks ONE
# session can run at once. Writes to the same workspace are serialized by the
# workspace lock no matter how high this is; raising it only lets unrelated work
# overlap. Each worker can drive a full agent CLI — budget CPU and provider
# quota accordingly. Default 3.
FLUXION_WORKER_COUNT=3
# In-flight cap per user (queued + running). Keep it above FLUXION_WORKER_COUNT:
# at parity there is no queue, so a submission arriving while every worker is
# busy is rejected instead of waiting. Default 5.
FLUXION_MAX_PENDING_PER_USER=5
FLUXION_MAX_RETRIES=1
FLUXION_RETRY_BACKOFF_SEC=2
FLUXION_CODEX_SKIP_GIT_REPO_CHECK=false
FLUXION_CODEX_SANDBOX_MODE=workspace-write
FLUXION_CODEX_BYPASS_SANDBOX=false
FLUXION_CLAUDE_COMMAND=
FLUXION_CLAUDE_PROVIDER=official
FLUXION_CLAUDE_AUTH_MODE=login
FLUXION_CLAUDE_MODEL=
FLUXION_CLAUDE_BASE_URL=
FLUXION_CLAUDE_API_KEY=
FLUXION_CLAUDE_AUTH_TOKEN=
FLUXION_CLAUDE_PERMISSION_MODE=acceptEdits
FLUXION_CLAUDE_USE_BARE_MODE=false
FLUXION_CLAUDE_APPEND_SYSTEM_PROMPT=
FLUXION_CLAUDE_ALLOWED_TOOLS=Bash,Read,Edit
FLUXION_CLAUDE_MAX_TURNS=0
FLUXION_ANTIGRAVITY_COMMAND=
FLUXION_ANTIGRAVITY_SANDBOX=false
# Auto-approve every agy tool call, in every run and every workspace. Usually
# NOT needed: a sub-agent run that asked for mode=workspace-write into an
# authorized workspace already gets permission for that run alone. Turn this on
# only to let messaging-channel tasks (which declare no mode) edit files.
FLUXION_ANTIGRAVITY_DANGEROUSLY_SKIP_PERMISSIONS=false
FLUXION_ANTIGRAVITY_PRINT_TIMEOUT_SEC=1800
FLUXION_ARTIFACT_MAX_FILES=8
# Filesystem change detection:
# - FLUXION_REVERT_CAPTURE=structured records executor-reported changes for safe
#   revert when available.
# - FLUXION_CHANGE_DETECTION=snapshot/force also snapshots the workspace to find
#   changed files; leave off unless you need broader detection.
FLUXION_CHANGE_DETECTION=off
FLUXION_REVERT_CAPTURE=structured
# ChangeSet captures small UTF-8 text files before/after a run so a recorded
# sub-agent run can be reverted safely. Set either value to 0 to disable.
FLUXION_CHANGE_SET_MAX_FILE_BYTES=1000000
FLUXION_CHANGE_SET_MAX_TOTAL_BYTES=20000000
FLUXION_STATUS_UPDATES=RUNNING,FAILED,CANCELED
FLUXION_UPLOAD_LOG_ON_SUCCESS=false
FLUXION_LOCALE_MODE=auto
FLUXION_UI_LOCALE=en
FLUXION_SLACK_TYPING_HEARTBEAT_SEC=6
FLUXION_SLACK_RUNNING_UPDATE_SEC=30

# Web UI token — required when binding to 0.0.0.0 (LAN/VPS exposure).
# Generate with: openssl rand -hex 16
# Leave empty for localhost-only use (no token needed).
FLUXION_UI_TOKEN=
# Web UI port used by the desktop companion when starting/opening fluxion-web.
FLUXION_UI_PORT=8765

# Model quota panel — shows each provider's live 5-hour / weekly windows in the
# web dashboard. On the desktop app's first launch, this list is initialized
# from detected usage sources. Later launches preserve the user's selection.
# Reads locally-stored credentials/logs locally.
#   - claude: queries the OAuth usage endpoint (login/subscription auth only).
#   - codex:  live ChatGPT usage endpoint (real-time), falling back to ~/.codex logs.
#   - antigravity: reads credit balances from the IDE's local sidecar (only while
#     the Antigravity IDE is running; shows "unavailable" otherwise).
FLUXION_USAGE_PANEL_ENABLED=true
FLUXION_USAGE_PROVIDERS=claude,codex,antigravity
FLUXION_USAGE_REFRESH_SEC=60
# User-Agent for the Claude usage endpoint; a claude-code/<ver> UA avoids 429s.
FLUXION_CLAUDE_CODE_USER_AGENT=claude-code/2.0.0
# Optional: override the Claude OAuth token used for the quota probe. Leave empty
# to auto-resolve from ~/.claude/.credentials.json.
FLUXION_CLAUDE_USAGE_TOKEN=
# Opt-in: also read the Claude OAuth token from the macOS Keychain when no token/
# file is found. Off by default so Fluxion never touches the system credential
# store unless you ask. (Reads the same "Claude Code-credentials" item the CLI uses.)
FLUXION_CLAUDE_USAGE_KEYCHAIN=false
# Opt-in: refresh Claude Code OAuth credentials for the quota probe. When true,
# Fluxion uses the stored refreshToken after a 401 or near-expiry and writes the
# updated access token back to the original credentials file or Keychain item.
FLUXION_CLAUDE_USAGE_AUTO_REFRESH=false
# Codex quota source: auto (live endpoint, then logs) | live (endpoint only) |
# logs (rollout logs only). Live uses the OAuth token in ~/.codex/auth.json.
FLUXION_CODEX_USAGE_MODE=auto
# Optional: override the Codex usage base URL (default https://chatgpt.com/backend-api).
FLUXION_CODEX_USAGE_BASE_URL=
# Opt-in: reconcile local Codex usage history against the live server totals.
FLUXION_CODEX_HISTORY_RECONCILIATION=false

# Cost-estimate price tables (Stats panel). A bundled snapshot ships with the
# package and is the offline fallback. Source of truth:
# github.com/superposed-labs/llm-price-table. Refresh manually anytime with
# `fluxion-usage --refresh-prices`.
# Background refresh (web service only): a best-effort daemon refreshes the
# cached tables when older than FLUXION_PRICE_REFRESH_DAYS. Enabled by default
# (a credential-free GET to a public repo; non-blocking, falls back to the
# bundled snapshot). Set false to disable, e.g. air-gapped / fully offline.
FLUXION_PRICE_AUTO_REFRESH=true
FLUXION_PRICE_REFRESH_DAYS=1
# Optional: override the source URLs (e.g. a fork or private mirror).
FLUXION_PRICE_MODEL_URL=
FLUXION_PRICE_PLAN_URL=

# Menu bar companion autostart. The menu bar app (Fluxion)
# can bring these services up when the app loads — each spawned by the app
# so it inherits the app's Documents-folder access (a background launchd agent
# does not, when the repo lives under ~/Documents). Each is started single-
# instance (skipped if already running). Set any to false to leave it manual.
# Read-only dashboard (fluxion-web):
FLUXION_MENU_AUTOSTART_WEB=true
# Cron / quota task daemon (fluxion-scheduler):
FLUXION_MENU_AUTOSTART_SCHEDULER=true
# Always-on messaging gateway (fluxion-gateway); off by default — it listens to
# every enabled Slack, Telegram, WeChat, QQ, Feishu, and LINE channel and
# dispatches tasks:
FLUXION_MENU_AUTOSTART_GATEWAY=false

# Menu appearance: both show the same brand-dot + percentage status title; this
# only changes the click-through. native = compact macOS-style dropdown menu;
# rich = quota-focused grouped panel (the default).
FLUXION_MENU_APPEARANCE=rich
# Optional Notch/Dynamic Island display mode for the macOS companion.
FLUXION_NOTCH_MODE=false
# Hide the notch while an app is fullscreen (incl. borderless video/games),
# fading it back when fullscreen ends. On by default; set false to keep the
# notch visible over fullscreen content.
FLUXION_NOTCH_HIDE_ON_FULLSCREEN=true

# Quota Reset Automation (Autoping & Notifications)
# Per-provider monitor scope is stored as managed scheduler rules, configured
# through the menu bar Preferences, web API, or `fluxion-scheduler --set-autoping`.
# The toggles below control what happens when a monitored reset is detected.
# Global Auto Ping switch. When on, a monitored reset triggers a keep-alive ping
# to anchor the next window. Off by default — a monitor never spends quota
# uninvited; turn this on to opt in.
FLUXION_AUTOPING_ENABLED=false
# Codex/Antigravity 5h windows only anchor after several pings on one session, so
# Auto Ping fires a short burst (resuming that session) until the window anchors.
# Max pings per reset event; if it still hasn't anchored it notifies once and
# gives up until the next reset. Typical anchoring takes a handful of pings, so a
# run that finishes under the cap stays silent.
FLUXION_AUTOPING_MAX_ATTEMPTS=12
# Post a message to Slack when any quota window resets.
FLUXION_MENU_SLACK_NOTIFY_REFRESH=false
# DM the FLUXION_TELEGRAM_ALLOWED_USERS when any quota window resets.
FLUXION_MENU_TELEGRAM_NOTIFY_REFRESH=false
# Notify WeChat users with a saved context token when any quota window resets.
# FLUXION_WECHAT_ALLOWED_USERS limits notification recipients and is required
# for inbound WeChat tasks.
FLUXION_MENU_WECHAT_NOTIFY_REFRESH=false
# Push LINE messages to FLUXION_LINE_ALLOWED_USERS when any quota window resets.
FLUXION_MENU_LINE_NOTIFY_REFRESH=false
# Optional: target Slack channel for notifications. If empty, falls back to the
# first channel configured in FLUXION_SLACK_CHANNEL_WORKSPACES.
FLUXION_SCHEDULER_SLACK_CHANNEL=


# Scheduler (fluxion-scheduler) — a standalone daemon that fires sub-agent runs
# on a cron schedule or when a provider quota window refreshes. Rules live in
# data/schedules.jsonl; state and run history in data/scheduler_state.json and
# data/schedule_runs.jsonl. Keep it alive with launchd/systemd.
FLUXION_SCHEDULER_ENABLED=false
# Poll interval in seconds. Reading quota is free, but the Claude endpoint
# dislikes hammering, so the daemon caps at 60s / floors at 15s. 0 = auto
# (derived from FLUXION_USAGE_REFRESH_SEC).
FLUXION_SCHEDULER_TICK_SEC=0

# ── WeChat iLink Channel ─────────────────────────────────────────────────────
# Requires a prior QR-code login.
# Run: python -m fluxion.channels.wechat.wechat_login
FLUXION_WECHAT_ENABLED=false
# Default workspace for WeChat tasks. Falls back to FLUXION_WORKSPACE_ROOT.
FLUXION_WECHAT_DEFAULT_WORKSPACE=
# Comma-separated iLink user IDs allowed to drive the bot. REQUIRED: fail-closed,
# so an empty list rejects inbound tasks. Rejected users get their ID in the
# reply and are recorded in data/wechat_pending_users.json; add or approve them
# here and the gateway hot-reloads the change.
FLUXION_WECHAT_ALLOWED_USERS=
# Max chars per outbound WeChat text message (default 4096).
FLUXION_WECHAT_MESSAGE_MAX_CHARS=4096
# Typing indicator heartbeat interval in seconds (default 8).
FLUXION_WECHAT_TYPING_HEARTBEAT_SEC=8

# ── Telegram Bot Channel ─────────────────────────────────────────────────────
# Enable the Telegram channel adapter (currently supports direct messages only).
# Create a bot and get the token from @BotFather, then set TELEGRAM_BOT_TOKEN.
FLUXION_TELEGRAM_ENABLED=false
# Bot token from @BotFather (required when FLUXION_TELEGRAM_ENABLED=true).
TELEGRAM_BOT_TOKEN=
# Default workspace for Telegram tasks. Falls back to FLUXION_WORKSPACE_ROOT.
FLUXION_TELEGRAM_DEFAULT_WORKSPACE=
# Comma-separated numeric Telegram user IDs allowed to drive the bot. REQUIRED:
# fail-closed, so an empty list rejects everyone (the bot will not respond).
# Tip: message @userinfobot to find your numeric user ID.
FLUXION_TELEGRAM_ALLOWED_USERS=

# ── LINE Bot Channel ──────────────────────────────────────────────────────────
# Enable the LINE channel adapter. It starts a local webhook server on port 8766;
# expose /line/webhook with a public tunnel and register that URL in the LINE
# Developers Console.
FLUXION_LINE_ENABLED=false
# Channel Secret from LINE Developers Console (Basic settings).
LINE_CHANNEL_SECRET=
# Channel Access Token from LINE Developers Console (Messaging API -> long-lived).
LINE_CHANNEL_ACCESS_TOKEN=
# Default workspace for LINE tasks. Falls back to FLUXION_WORKSPACE_ROOT.
FLUXION_LINE_DEFAULT_WORKSPACE=
# Comma-separated LINE user IDs (U...) allowed to drive the bot. REQUIRED:
# fail-closed, so an empty list rejects everyone (the bot will not respond).
FLUXION_LINE_ALLOWED_USERS=
# Optional: Cloudflare tunnel name used by setup_tunnel.sh and the desktop app
# (default: fluxion-line).
FLUXION_LINE_TUNNEL_NAME=

# ── Inbound Attachments ──────────────────────────────────────────────────────
# Files users send (Slack/Telegram/WeChat/LINE) are saved into <workspace>/.fluxion_inbox/
# so the executor agent can read them. Sub-folders older than this many hours
# are auto-deleted when a new attachment arrives. 0 disables cleanup. Default 24.
FLUXION_INBOX_TTL_HOURS=24

# Enable the Slack channel adapter. Default true (back-compat). Set false to run
# the gateway with only other channels (e.g. Telegram, WeChat, or LINE); when
# false the Slack tokens below are not required.
FLUXION_SLACK_ENABLED=true
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...
